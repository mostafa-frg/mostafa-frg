{
  "$schema":"https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name":"mosta-platform",
  "main":"src/index.js",
  "compatibility_date":"2026-11-09",
  "workers_dev":true,
  "assets":{"directory":"../portfolio","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"mosta-platform","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}],
  "vars":{"APP_NAME":"MOSTA"}
}