[
  {"id": "SSH-BRUTE", "title": "SSH brute force", "level": "high", "tags": ["attack.t1110"],
   "match": {"all": [{"field": "event", "op": "eq", "value": "ssh_failed"}]},
   "threshold": {"count": 5, "window": 120, "group_by": ["src_ip"]}},
  {"id": "WEB-SCAN", "title": "Probing for sensitive files", "level": "medium", "tags": ["attack.t1595"],
   "match": {"all": [{"field": "event", "op": "eq", "value": "http_request"}, {"field": "path", "op": "regex", "value": "(\\.env|wp-login|\\.git/|phpmyadmin)"}, {"field": "status", "op": "ge", "value": 400}]}},
  {"id": "WEB-SQLI", "title": "SQL injection pattern in URL", "level": "high", "tags": ["attack.t1190"],
   "match": {"any": [{"field": "path", "op": "regex", "value": "(?i)(%27|')\\s*(or|and)\\s|union(%20|\\+| )select"}, {"field": "user_agent", "op": "contains", "value": "sqlmap"}]}}
]
