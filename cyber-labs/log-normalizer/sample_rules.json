[
  {
    "id": "SSH-BRUTE",
    "title": "Repeated failed SSH authentication",
    "level": "high",
    "tags": ["attack.t1110"],
    "match": {
      "all": [
        {"field": "event_type", "op": "eq", "value": "authentication"},
        {"field": "action", "op": "eq", "value": "failed"}
      ]
    },
    "threshold": {
      "count": 5,
      "window": 300,
      "group_by": ["src_ip"]
    }
  }
]
