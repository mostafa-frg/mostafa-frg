#!/usr/bin/env bash
set -euo pipefail
BASE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$BASE/banner.sh"
mosta_banner "MOSTA EXTERNAL TOOLS"
cat <<'EOF'
Core network commands:
  mnmap        Nmap
  mnc          Netcat
  mdig         dig
  mtcpdump     tcpdump
  msocat       socat
  mtracepath   tracepath
  mtraceroute  traceroute
  mwhois       whois
  mcurl        curl
  mwget        wget
  mssh         OpenSSH

Optional security / analysis commands:
  mtshark      TShark
  mwireshark   Wireshark
  mscapy       Scapy
  maircrack    Aircrack-ng
  mkismet      Kismet
  mnikto       Nikto
  mffuf        ffuf
  mmtr         MTR
  mjohn        John the Ripper
  mhashcat     Hashcat
  mhydra       Hydra
  mzeek        Zeek
  msuricata    Suricata
  mmetsploit   Metasploit
  msqlmap      SQLMap
  msearchsploit SearchSploit
  mburp        Burp Suite
  mzap         OWASP ZAP

All wrappers pass arguments to the real executable. Availability is checked at runtime.
Use mosta-doctor for the installed core set.
EOF
